{
	"name": "PL_AzureSQL_DB_Migration",
	"properties": {
		"activities": [
			{
				"name": "Lookup_MigrationConfig",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MigrationConfig",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_MigrationConfig",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_MigrationConfig').output.value",
						"type": "Expression"
					},
					"batchCount": 10,
					"activities": [
						{
							"name": "SP_DisableConstraints",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[Migration].[DisableConstraints]",
								"storedProcedureParameters": {
									"SchemaName": {
										"value": "@item().TargetSchema",
										"type": "String"
									},
									"TableName": {
										"value": "@item().TargetTable",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_azsql_tgt",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Copy_TableData",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "SP_DisableConstraints",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": "SELECT * \nFROM [@{dataset().SchemaName}].[@{dataset().TableName}]",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_Source_AzureSQL",
									"type": "DatasetReference",
									"parameters": {
										"SchemaName": "@item().SourceSchema",
										"TableName": "@item().SourceTable"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Target_AzureSQL",
									"type": "DatasetReference",
									"parameters": {
										"SchemaName": "@item().TargetSchema",
										"TableName": "@item().TargetTable"
									}
								}
							]
						},
						{
							"name": "SP_EnableConstraints",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy_TableData",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[Migration].[EnableConstraints]",
								"storedProcedureParameters": {
									"SchemaName": {
										"value": "@item().TargetSchema",
										"type": "String"
									},
									"TableName": {
										"value": "@item().TargetTable",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_azsql_tgt",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}